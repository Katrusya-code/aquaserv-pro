      ))}
      <button onClick={onAdd} style={{flex:1,display:"flex",flexDirection:"column",alignItems:"center",gap:3,border:"none",background:"none",cursor:"pointer"}}>
        <div style={{width:40,height:40,background:`linear-gradient(135deg,${AQUA},#0369A1)`,borderRadius:"50%",display:"flex",alignItems:"center",justifyContent:"center",color:"white",fontSize:24,marginTop:-14,boxShadow:"0 4px 12px rgba(14,165,233,.4)"}}>+</div>
        <span style={{fontSize:11,fontWeight:600,color:"#94A3B8"}}>Add Client</span>
      </button>
    </div>
  );
}

function Lbl({children}){return <div style={{fontSize:12,fontWeight:600,color:"#64748B",textTransform:"uppercase",letterSpacing:.8,marginBottom:6,marginTop:12}}>{children}</div>;}
function Inp(p){return <input {...p} style={{width:"100%",padding:"12px 14px",background:"white",border:"1.5px solid #E2E8F0",borderRadius:12,fontSize:14,color:"#1E293B",marginBottom:4,outline:"none",fontFamily:"inherit",...(p.style||{})}}/>;}
function Sel({children,...p}){return <select {...p} style={{width:"100%",padding:"12px 14px",background:"white",border:"1.5px solid #E2E8F0",borderRadius:12,fontSize:14,color:"#1E293B",marginBottom:4,appearance:"none",outline:"none",fontFamily:"inherit"}}>{children}</select>;}
function IR({label,val}){return <div style={{display:"flex",gap:10,marginBottom:6}}><span style={{fontSize:12,color:"#94A3B8",fontWeight:600,minWidth:52}}>{label}</span><span style={{fontSize:13,color:"#334155"}}>{val}</span></div>;}
function Loader(){return <div style={{textAlign:"center",padding:"48px",color:"#94A3B8",fontSize:14,fontWeight:600}}>↻ Loading from Google Sheets…</div>;}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<App/>);
</script>
</body>
</html>
