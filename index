function AddEquipmentForm({onSave,onCancel}){
  const types=Object.keys(CAT);
  const [type,setType]=useState("uv");
  const [groupIdx,setGroupIdx]=useState(0);
  const [modelId,setModelId]=useState(CAT.uv.models[0].id);
  const [installDate,setInstallDate]=useState(new Date().toISOString().split("T")[0]);
  const [installType,setInstallType]=useState("domestic");
  const cat=CAT[type];
  const hasGroups=!!cat.groups;
  function getGMs(c,gi){if(!c.groups)return c.models;const g=c.groups[gi];if(g?.models)return g.models;return(g?.sizes||[]).map(s=>({id:`${g.k}_${s}`,name:`${g.g} ${s}`,unitCode:`SOFT-${g.k.toUpperCase()}-${s}`}));}
  function changeType(t){setType(t);setGroupIdx(0);setModelId(getGMs(CAT[t],0)[0]?.id||"");}
  function changeGroup(gi){setGroupIdx(gi);setModelId(getGMs(cat,gi)[0]?.id||"");}
  const gms=getGMs(cat,groupIdx);
  const model=cat.models.find(m=>m.id===modelId)||gms[0];
  const svcs=model?.services||cat.services||[];
  return(
    <div style={{background:"white",borderRadius:16,padding:16,boxShadow:"0 1px 8px rgba(0,0,0,.06)"}}>
      <div style={{fontWeight:700,fontSize:15,color:"#1E293B",marginBottom:14}}>Add Equipment</div>
      <Lbl>Equipment Type</Lbl>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8,marginBottom:14}}>
        {types.map(t=>{const c=CAT[t];return<button key={t} onClick={()=>changeType(t)} style={{padding:"10px 6px",borderRadius:12,fontSize:11,fontWeight:600,border:`2px solid ${type===t?c.color:"#E2E8F0"}`,background:type===t?c.light:"white",color:type===t?c.color:"#94A3B8",display:"flex",flexDirection:"column",alignItems:"center",gap:3,cursor:"pointer"}}><span style={{fontSize:18}}>{c.icon}</span><span>{c.label}</span></button>;})}
      </div>
      {hasGroups&&<><Lbl>Series</Lbl><Sel value={groupIdx} onChange={e=>changeGroup(Number(e.target.value))}>{cat.groups.map((g,i)=><option key={i} value={i}>{g.g}</option>)}</Sel></>}
      <Lbl>Model</Lbl>
      <Sel value={modelId} onChange={e=>setModelId(e.target.value)}>{gms.map(m=><option key={m.id} value={m.id}>{m.name}</option>)}</Sel>
      {model&&<div style={{background:"#F8FAFC",borderRadius:10,padding:"10px 12px",marginBottom:12,marginTop:4}}>
        <div style={{fontSize:11,color:"#64748B",marginBottom:4}}>Unit code: <span style={{fontFamily:"monospace",fontWeight:600,color:"#1E293B"}}>{model.unitCode||"—"}</span></div>
        {svcs.map(s=><div key={s.key} style={{fontSize:11,color:"#64748B"}}>→ {s.label} · <span style={{fontFamily:"monospace",fontWeight:600,color:"#1E293B"}}>{s.partCode}</span> · every {s.interval}mo</div>)}
        {type==="softener"&&<><div style={{fontSize:11,color:"#64748B"}}>→ Valve: Domestic 12mo / Commercial 6mo</div><div style={{fontSize:11,color:"#64748B"}}>→ Media replacement: every 60mo (5 years)</div></>}
      </div>}
      {type==="softener"&&<>
        <Lbl>Installation Type</Lbl>
        <div style={{display:"flex",gap:8,marginBottom:4}}>
          {["domestic","commercial"].map(t=><button key={t} onClick={()=>setInstallType(t)} style={{flex:1,padding:"10px",borderRadius:10,fontSize:13,fontWeight:600,border:`2px solid ${installType===t?"#059669":"#E2E8F0"}`,background:installType===t?"#F0FDF4":"white",color:installType===t?"#059669":"#94A3B8",cursor:"pointer"}}>{t==="domestic"?"🏠 Domestic (12mo)":"🏢 Commercial (6mo)"}</button>)}
        </div>
      </>}
      <Lbl>Installation Date</Lbl>
      <Inp type="date" value={installDate} onChange={e=>setInstallDate(e.target.value)}/>
      <div style={{display:"flex",gap:10,marginTop:8}}>
        <button onClick={onCancel} style={{flex:1,padding:"12px",borderRadius:12,background:"#F1F5F9",fontWeight:600,color:"#475569",fontSize:14,border:"none",cursor:"pointer"}}>Cancel</button>
        <button onClick={()=>{const m=cat.models.find(m=>m.id===modelId)||gms[0];onSave({type,modelId:m?.id,modelName:m?.name,unitCode:m?.unitCode,installDate,installType:type==="softener"?installType:undefined});}} style={{flex:2,padding:"12px",borderRadius:12,background:AQUA,fontWeight:700,color:"white",fontSize:14,border:"none",cursor:"pointer"}}>Add Equipment</button>
      </div>
    </div>
  );
}

