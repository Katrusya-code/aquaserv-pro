        const w=ca.find(a=>a.status==="overdue")?"overdue":ca.find(a=>a.status==="urgent")?"urgent":ca.find(a=>a.status==="soon")?"soon":"ok";
        return(
          <div key={c.id} className="card" onClick={()=>onClientClick(c.id)} style={{background:"white",borderRadius:16,padding:16,boxShadow:"0 1px 8px rgba(0,0,0,.06)",display:"flex",justifyContent:"space-between",alignItems:"center",cursor:"pointer",animationDelay:`${i*.04}s`}}>
            <div style={{flex:1,minWidth:0}}>
              <div style={{fontWeight:700,fontSize:16,color:"#0F172A"}}>{c.name}</div>
              <div style={{fontSize:12,color:"#64748B",marginTop:2,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{c.address}</div>
              <div style={{display:"flex",gap:5,marginTop:8,flexWrap:"wrap"}}>
                {c.equipment?.map(eq=>{const cat=CAT[eq.type];const m=findModel(eq.type,eq.modelId);return cat?<span key={eq.id} style={{background:cat.light,color:cat.color,fontSize:10,fontWeight:600,padding:"3px 8px",borderRadius:8}}>{cat.icon} {m?.name||"Unit"}</span>:null;})}
              </div>
            </div>
            <div style={{display:"flex",flexDirection:"column",alignItems:"flex-end",gap:4,marginLeft:12}}>
              {n>0&&<div style={{background:ST[w].badge,color:"white",fontSize:11,fontWeight:700,borderRadius:10,padding:"2px 8px"}}>{n} alert{n!==1?"s":""}</div>}
              <span style={{color:"#CBD5E1",fontSize:20}}>›</span>
            </div>
          </div>
        );
      })}
      {!filtered.length&&q&&<div style={{textAlign:"center",padding:"32px",color:"#94A3B8",fontSize:14}}>No results for "{q}"</div>}
    </div>
  );
}

